
[Unit]
Description=zigmirror - Zig Community Mirror Cache Server
After=network.target

[Service]
Type=exec
ExecStart=/usr/local/bin/zigmirror /usr/local/etc/zigmirror.sx
Restart=always
RestartSec=1
RestartSteps=7
RestartMaxDelaySec=300
User=zigmirror
Group=zigmirror

# Only needed if listening on port 80 directly:
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target